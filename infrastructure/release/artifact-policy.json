{
  "$schema": "./schema/artifact-policy.schema.json",
  "policy_version": 1,
  "description": "Phase 0O.6A (ADR 0052 section 3.12): the one machine-readable release artifact policy. verify-artifact reads only this file. NO PRODUCTION REGISTRY IS CONFIGURED; NO REAL SIGNING IDENTITY/KEY IS CONFIGURED.",
  "source": {
    "repository": "https://github.com/mawk-khan/lycenza",
    "protected_branch": "main",
    "protected_remote_ref": "origin/main"
  },
  "images": {
    "app": {
      "name": "lycenza-app",
      "dockerfile": "infrastructure/docker/production/app.Dockerfile",
      "context": "apps/platform",
      "target": "runtime",
      "platform": "linux/amd64",
      "sbom_required_purl_types": ["deb", "composer"]
    },
    "ai-gateway": {
      "name": "lycenza-ai-gateway",
      "dockerfile": "infrastructure/docker/production/ai.Dockerfile",
      "context": "services/ai",
      "target": "runtime",
      "platform": "linux/amd64",
      "sbom_required_purl_types": ["deb", "pypi"]
    }
  },
  "required_evidence": {
    "sbom_format": "SPDX-2.3",
    "statement_type": "https://in-toto.io/Statement/v1",
    "provenance_predicate": "https://slsa.dev/provenance/v1",
    "build_type": "https://github.com/mawk-khan/lycenza/blob/main/infrastructure/release/README.md#build-type-oci-image-v1",
    "signature": "cosign-sign-blob",
    "vulnerability_scanner": "grype",
    "language_audits": ["composer", "npm", "pip"],
    "source_secret_scan": "gitleaks",
    "image_secret_scan": "gitleaks",
    "image_config_scan": true,
    "complete_regression": true
  },
  "vulnerability_policy": {
    "blocking": {
      "critical": "always",
      "high": "when_fix_available"
    },
    "exception_required": {
      "high": "when_no_fix"
    },
    "recorded_not_blocking": ["medium", "low", "negligible", "unknown"],
    "unrated_language_advisory_severity": "high",
    "scanner_db_max_age_hours": 24,
    "exception_file": "infrastructure/release/vulnerability-exceptions.json",
    "exception_max_days": {
      "critical": 30,
      "high": 30,
      "other": 90
    }
  },
  "signing": {
    "custody": "unconfigured",
    "public_key_ref": "",
    "certificate_identity": "",
    "certificate_oidc_issuer": "",
    "test_signing": "ephemeral-per-run-key-non-production"
  },
  "tools": {
    "buildkit": "moby/buildkit:v0.26.3@sha256:5601811fde88bb9e8a577bfe804af82bccb712e1cd07ff94663bded5e628cf75",
    "syft": "anchore/syft:v1.33.0@sha256:f94e5d9fce1f2278491a8e3a63bd5f6ddb81fdfdbb8bf7a1637565c1d5344357",
    "grype": "anchore/grype:v0.100.0@sha256:dcf0168c9b275c6dbcbff5ceeecfac29a6ccf138a87f0adc9ce5bd69fe6146f3",
    "cosign": "ghcr.io/sigstore/cosign/cosign:v2.6.1@sha256:68839b7f13dac5a6744a5d8818e984dd39183374e37855c19e14d623d9bc9037",
    "gitleaks": "zricethezav/gitleaks:v8.28.0@sha256:cdbb7c955abce02001a9f6c9f602fb195b7fadc1e812065883f695d1eeaba854",
    "python": "python:3.12.14-slim-bookworm@sha256:a116514e19457bcb7af7efe9c3dd0b9b71e85b317694e7882a1c52aa15a78134",
    "composer": "composer:2.10.2@sha256:4d71c3c2109c61d5415544264b59ad4087e4c5b7244481723664138fd36d5040",
    "node": "node:22.23.3-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c"
  },
  "states": {
    "repository_reachable": ["BUILT", "VERIFIED"],
    "deploy_gated": ["PUBLISHED", "PROMOTED"]
  }
}
