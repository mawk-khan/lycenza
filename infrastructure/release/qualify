#!/usr/bin/env python3
"""Release qualification entry point (ADR 0052). See infrastructure/release/README.md."""
import sys
from pathlib import Path

# Never write bytecode into the checked-out tree (the run requires a clean tree).
sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))
from lycenza_release.qualify import main  # noqa: E402

sys.exit(main())
