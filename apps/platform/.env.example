APP_NAME="School OS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

# Local default. Production MUST use APP_MAINTENANCE_DRIVER=cache with
# APP_MAINTENANCE_STORE=database (one flag for every container; the boot
# check refuses `file` -- Phase 0O.4A, docs/operations/).
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Phase 0O.5A (ADR 0051): `json` (one object per line, fixed schema -- the
# production default and requirement) or `line` (readable; local default).
# LOG_FORMAT=line

# Metrics (ADR 0051 section 9): the private listener's bearer scrape token.
# Production secret (O4); no default -- empty means every scrape is refused.
# For a local review use an obviously fake value, never a real one.
METRICS_SCRAPE_TOKEN=
# redis (default: shared across processes) | array | null
# METRICS_STORE=redis
# Deployment-controlled backup/restore-drill evidence file (read-only mount).
# OBSERVABILITY_DEPLOYMENT_EVIDENCE_FILE=

# PostgreSQL is the only supported system-of-record database.
# See docs/architecture/adr/0003-postgresql-system-database.md
#
# Two roles, two purposes -- see
# docs/architecture/adr/0021-postgresql-runtime-vs-migration-roles.md:
#   school_os      -- superuser/table owner. Migrations ONLY
#                      (php artisan migrate --database=pgsql_admin).
#   school_os_app  -- NOSUPERUSER, NOBYPASSRLS. Every runtime connection
#                      (web/queue/schedule) uses this and only this.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=school_os
DB_USERNAME=school_os_app
DB_PASSWORD=school_os_app_local_only_password

DB_ADMIN_USERNAME=school_os
DB_ADMIN_PASSWORD=school_os

# E21-RH.2 (ADR 0066): the dedicated retention identity, used only by the
# destructive retention steps of the scheduled retention commands. No
# fallback to the runtime or migration login; unset = those steps refuse.
DB_RETENTION_USERNAME=school_os_retention
DB_RETENTION_PASSWORD=school_os_retention_local_only_password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=school_os_cache

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Laravel's own mailers are for framework internals and local work only:
# application email never uses them (ADR 0055). `failover`/`sendmail` were
# removed; production refuses a log/array default while email is enabled.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="notifications@notify.school-os.test"
MAIL_FROM_NAME="${APP_NAME}"

# Production email & deliverability (ADR 0055, Phase 0O.9A) -- every
# business email goes through the durable email layer (config/email.php).
# MAIL_PROVIDER: none (email explicitly disabled -- nothing is submitted,
# nothing claims to be sent) | fake (local/testing only, no network) |
# smtp (the hardened SMTP baseline; MAIL_HOST/PORT/USERNAME/PASSWORD above,
# TLS required). No vendor is chosen. Real credentials never go here.
MAIL_PROVIDER=fake
# A Lycenza-controlled sending domain, never a School's web domain.
MAIL_SENDING_DOMAIN=notify.school-os.test
# Operator attestation of the DNS/provider evidence (production only).
MAIL_SENDING_VERIFIED=false
# required | implicit | none (none: Mailpit in local/testing only).
MAIL_SMTP_TLS=required
MAIL_SMTP_TIMEOUT_SECONDS=5
# Provider events: none | fake (local/testing only).
MAIL_PROVIDER_EVENTS=fake
MAIL_PROVIDER_EVENT_SECRET=dev-local-only-mail-provider-event-secret-change-me
MAIL_PROVIDER_EVENT_PREVIOUS_SECRET=
# Suppression fingerprint key ring (current + optional previous, with ids).
MAIL_SUPPRESSION_HMAC_KEY=dev-local-only-mail-suppression-hmac-key-change-me
MAIL_SUPPRESSION_HMAC_KEY_ID=dev-1
MAIL_SUPPRESSION_HMAC_PREVIOUS_KEY=
MAIL_SUPPRESSION_HMAC_PREVIOUS_KEY_ID=
# Where platform:mail-verify-domain looks (read-only DNS evidence).
MAIL_RETURN_PATH_DOMAIN=
MAIL_DKIM_SELECTOR=
# E21-D2 (docs/security/E21-RETENTION-DETERMINATION.md): production sets
# the project-adopted 180 (pending legal ratification). Unset here, so a
# local environment never prunes; unset means email metadata is never deleted.
MAIL_RETENTION_DAYS=

# Self-service account recovery (ADR 0056, Phase 0O.10A) -- identity-level
# password reset by email on the platform host only. Disabled by default;
# production refuses `true` unless critical email is configured, and it is
# deployed only with the evidence in docs/operations/ACCOUNT-RECOVERY.md.
ACCOUNT_RECOVERY_ENABLED=false

# Communication Hub outbound email (Phase 5A.3) -- disabled by default.
# Communication Hub's own explicit product gate; the email itself goes
# through the email layer above (and MAIL_PROVIDER=none refuses it).
COMMUNICATION_EMAIL_ENABLED=false

# Guardian account invitation (Phase 5D.3, Identity domain) -- how
# many days an issued invitation stays usable. Its email is queued in
# the invitation's own transaction and sent by the email layer
# (MAIL_PROVIDER above), independent of COMMUNICATION_EMAIL_ENABLED,
# which gates Communication Hub broadcasts only.
GUARDIAN_INVITATION_EXPIRY_DAYS=7

# Webhook delivery-history retention (Phase 0C closeout; E21-D4). Production
# sets the project-adopted values from docs/security/E21-RETENTION-DETERMINATION.md
# (pending legal ratification): delivered 30, failed/abandoned 90. Unset here:
# while unset, the daily `platform:webhook-deliveries-prune` deletes nothing.
# WEBHOOKS_DELIVERY_RETENTION_DAYS=
# WEBHOOKS_FAILED_DELIVERY_RETENTION_DAYS=
# WEBHOOKS_PRUNE_BATCH_SIZE=500

# E21 retention (docs/security/E21-RETENTION-DETERMINATION.md, project-adopted,
# pending legal ratification). Production values: outbox 30, failed jobs 30.
# Unset means the daily prune deletes nothing. RETENTION_HOLD_SCHOOL_IDS
# (comma-separated School ids) exempts held Schools from every
# tenant-scoped prune.
# OUTBOX_RETENTION_DAYS=
# FAILED_JOBS_RETENTION_DAYS=
# RETENTION_HOLD_SCHOOL_IDS=
# RETENTION_PRUNE_BATCH_SIZE=500
# E21.2B: calendar-year periods. Production values: audit 7, authority
# history 7, released email suppressions 1. They are expired through the
# narrow database retention functions; the database refuses any shorter
# period. RETENTION_HOLD_PLATFORM=true holds every record that belongs to
# no School.
# AUDIT_RETENTION_YEARS=
# AUTHORITY_HISTORY_RETENTION_YEARS=
# MAIL_RELEASED_SUPPRESSION_RETENTION_YEARS=
# RETENTION_HOLD_PLATFORM=false
# E21.2C: Communications content 3 calendar years after the end of the
# Academic Year sent; delivery telemetry 1 calendar year after the terminal
# time; proven orphan objects 30 days.
# COMMUNICATIONS_CONTENT_RETENTION_YEARS=
# COMMUNICATIONS_DELIVERY_RETENTION_YEARS=
# STORAGE_ORPHAN_RETENTION_DAYS=
# RETENTION_ORPHAN_SCAN_LIMIT=10000
# E21.2D (E21-D7): calendar years after a Student's final exit. Operational
# history (attendance, rollover items, Guardian relationships; E21.3B:
# returned Library loans, ended Transport/Hostel assignments) 7; the core
# academic record (identity, placements, subject enrollments, Documents;
# E21.3B: processing authorizations, converted admissions, consent events,
# domain preferences) 25.
# STUDENT_OPERATIONAL_RETENTION_YEARS=
# STUDENT_CORE_RETENTION_YEARS=
# E21.3B (E21.2G I2): days after an ended portal invitation ended (accepted,
# revoked or expired unaccepted), adopted 7.
# PORTAL_INVITATION_RETENTION_DAYS=
# E21.3C (E21.2G AD2/G1): calendar years after a rejected/withdrawn
# application's terminal decision (1), and after a Guardian last had a
# Student relationship (1). Run platform:admission-decisions-backfill and
# platform:guardian-markers-backfill once before enabling.
# ADMISSIONS_TERMINAL_RETENTION_YEARS=
# GUARDIAN_RETENTION_YEARS=
# E21.3D (E21.2G A1): calendar years after the end of the Academic Year of
# curriculum deliveries, empty attendance register headers, timetable entries
# and LMS Learning Content/Assignments (7).
# ACADEMIC_OPERATIONS_RETENTION_YEARS=
# E21.3E (E21.2G C1/C2/O2-O4): calendar years after a never-sent announcement
# was cancelled/rejected or an empty thread's last activity (1), after an
# ended driver assignment (7), a visit's checkout (1), an automation
# execution's completion (1). Ended API credentials use
# AUTHORITY_HISTORY_RETENTION_YEARS (D6).
# COMMUNICATIONS_ABANDONED_RETENTION_YEARS=
# OPERATIONS_DRIVER_ASSIGNMENT_RETENTION_YEARS=
# OPERATIONS_VISIT_RETENTION_YEARS=
# OPERATIONS_AUTOMATION_RETENTION_YEARS=
# E21.2E (E21-D9): calendar years after an Employee's final separation.
# Ancillary sub-records (addresses, emergency contacts, notes,
# qualifications, experience, certifications) 2; employment and payroll
# evidence with the Employee 8.
# EMPLOYEE_ANCILLARY_RETENTION_YEARS=
# EMPLOYEE_EVIDENCE_RETENTION_YEARS=
# E21.3A2 (E21-D8, ADR 0064): calendar years after a financial period's
# CLOSE, adopted 8 (less is refused). Deletion also needs the explicit
# switch, off by default; enable only after the period backfill, ambiguity
# resolution, historical closes and a passing platform:finance-balances-verify.
# FINANCE_RETENTION_YEARS=
# FINANCE_RETENTION_ENABLED=false

# Analytics minimum person-cohort size (ADR 0040 §6, Phase 0L.2-1).
# Deliberately unset: no value has been approved
# (docs/security/ANALYTICS-SMALL-COHORT-POLICY-GATE.md). While unset,
# every Analytics report that counts people fails closed (HTTP 503).
# ANALYTICS_MINIMUM_PERSON_COHORT_SIZE=

# S3-compatible object storage. Local dev points this at the MinIO
# container defined in infrastructure/docker/docker-compose.yml.
# See docs/architecture/adr/0011-object-storage-strategy.md
AWS_ACCESS_KEY_ID=school_os
AWS_SECRET_ACCESS_KEY=school_os_secret
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=school-os-local
AWS_ENDPOINT=http://localhost:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# No SSR bundle is built in Phase 0A (server-side rendering is a later
# performance/SEO decision, not an architectural one).
INERTIA_SSR_ENABLED=false

# Disabled by default: when run inside Docker (root), DevTools writes
# to storage/inertia-devtools on the host-mounted volume as root,
# which then blocks host-side tools (ESLint, etc.) with EACCES until
# manually removed via a root-privileged container. Enable locally on
# a non-Docker setup if you want it.
INERTIA_DEVTOOLS_ENABLED=false

VITE_APP_NAME="${APP_NAME}"

# Cross-origin browser access to the API (Phase 0O.3, ADR 0049 section 10):
# exact origins only, comma-separated (e.g. https://partner.example.com).
# Empty = no cross-origin access. Wildcards/patterns are refused at boot.
CORS_ALLOWED_ORIGINS=

# Reverse proxies whose X-Forwarded-For/Host/Port/Proto headers are believed
# (Phase 0O.4A, ADR 0050): explicit IPs/CIDRs, comma-separated (e.g.
# 10.0.0.0/8). Empty = trust nobody (local default). `*`, 0.0.0.0/0, ::/0,
# over-broad ranges and hostnames are refused at configuration load.
TRUSTED_PROXIES=

# Production (APP_ENV=production) additionally refuses to boot unless:
# DB_CONNECTION=pgsql, DB_SSLMODE=require|verify-ca|verify-full, a
# REDIS_PASSWORD, DOCUMENTS_DISK=s3 and COMMUNICATION_ATTACHMENTS_DISK=s3,
# a non-local AWS_BUCKET, an https AWS_ENDPOINT (or none), a real APP_URL,
# a shared maintenance driver, LOG_FORMAT=json and a METRICS_SCRAPE_TOKEN of
# at least 32 characters. None of the local values in this file
# works there. See docs/operations/PRODUCTION-IMAGES-AND-PROCESSES.md.

# AI Gateway (services/ai FastAPI). ERP domain code must never call a
# model provider directly — only this gateway. See docs/ai/AI-PLATFORM.md
# and docs/architecture/adr/0023-ai-context-token-strengthening.md.
# Phase 0O.1: with APP_ENV=production the application refuses to boot
# with either value below, with APP_DEBUG on, without a usable APP_KEY,
# or without SESSION_SECURE_COOKIE=true
# (docs/architecture/PRODUCTION-RELEASE.md).
AI_GATEWAY_BASE_URL=http://localhost:8100
# ADR 0053 (Phase 0O.7A): DEVELOPMENT-ONLY Ed25519 service keys, public in
# this repository and refused in production (kid prefix dev-local-only- and
# public-key fingerprint). Laravel's own `platform` signing key, and the ring
# of the Gateway's `ai-gateway` PUBLIC keys. Production keys come only from
# the managed secret store (docs/operations/SERVICE-KEY-ROTATION.md).
AI_GATEWAY_SERVICE_SIGNING_KEY='{"kty":"OKP","crv":"Ed25519","kid":"dev-local-only-platform-1","x":"kV3ZvDdDEsrXYdor998DAGfkdizSSsRSzKHycfGuEUQ","d":"XZoBPMZruZQzihxKjIBvRRf7cuG1E1zAoq2IWtvQgKI","created":"2026-09-27"}'
AI_GATEWAY_INBOUND_VERIFICATION_KEYS='[{"kty":"OKP","crv":"Ed25519","kid":"dev-local-only-ai-gateway-1","x":"WibFMaiB1A6KTbuNEVn8oOm2Qg1pUy1upMSmLbIy1tE","created":"2026-09-27"}]'
# Held ONLY by Laravel -- never given to services/ai. Local-only value;
# a real deployment generates this per environment (ADR 0016). Required
# in every environment: without it no AI context token is issued or
# accepted.
AI_GATEWAY_CONTEXT_SIGNING_KEY=dev-local-only-context-signing-key-change-me

# Hosts and custom School domains (ADR 0054, Phase 0O.8A). Every request
# Host is classified exactly: the APP_URL host (+ DOMAIN_PLATFORM_ALIASES),
# the private INTERNAL_HOSTS (the name the AI Gateway calls: `platform` in
# docker-compose), an ACTIVE custom domain, or refused with 421. Locally the
# development hosts (localhost, 127.0.0.1, *.ddev.site) and the FAKE DNS
# resolver / TLS prober are on -- both honoured only in local/testing and
# refused in production. The probe key below is a public, local-only value.
CUSTOM_DOMAINS_ENABLED=true
DOMAIN_FAKES_ENABLED=true
DOMAIN_ALLOW_DEVELOPMENT_HOSTS=true
INTERNAL_HOSTS=platform
DOMAIN_PLATFORM_ALIASES=
DOMAIN_RESERVED_HOSTS=
DOMAIN_RESERVED_SUFFIXES=
DOMAIN_EDGE_CNAME_TARGET=edge.lycenza-local.invalid
DOMAIN_EDGE_ADDRESSES=1.2.3.4,1.2.3.5
DOMAIN_DNS_RESOLVERS=
DOMAIN_PROBE_KEY=dev-local-only-domain-probe-key-change-me-0000
SESSION_HANDOFF_STORE=

# Guardian contact exact-match lookup digest (Phase 1A.3). Deliberately
# a separate secret from APP_KEY so the two can be rotated
# independently -- see docs/modules/STUDENT-GUARDIAN-IDENTITY.md.
# Local-only value; a real deployment generates this per environment
# (ADR 0016).
CONTACT_LOOKUP_HMAC_KEY=dev-local-only-contact-lookup-hmac-key-change-me
CONTACT_LOOKUP_HMAC_KEY_VERSION=1

# Checkpoint 9.6C: statutory identifier (PAN/UAN/PF Member ID/ESIC IP
# Number) exact-match lookup digest -- its own dedicated key, separate
# from CONTACT_LOOKUP_HMAC_KEY above (ADR 0035). Local-only value; a
# real deployment generates this per environment (ADR 0016).
STATUTORY_IDENTIFIER_LOOKUP_HMAC_KEY=dev-local-only-statutory-identifier-lookup-hmac-key-change-me
STATUTORY_IDENTIFIER_LOOKUP_HMAC_KEY_VERSION=1
