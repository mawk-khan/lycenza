<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            force="true" on every entry below is deliberate, not
            decorative. Without it, PHPUnit's own documented behavior
            (see vendor/phpunit/phpunit/src/TextUI/Configuration/
            PhpHandler.php: `if ($force || getenv($name) === false)`)
            is to define a variable ONLY if it is not already present
            in the process environment: it never overrides one that
            is already set. This project's docker-compose.yml loads
            apps/platform/.env into the platform container via
            `env_file:`, which makes every value in that .env (dev
            defaults such as CACHE_STORE=redis, QUEUE_CONNECTION=redis,
            MAIL_MAILER=log, DB_DATABASE=school_os, APP_ENV=local)
            a real ambient process environment variable inside the
            container, so without force="true", every one of THESE
            entries was being silently ignored whenever tests ran via
            `docker exec` into that container, and the ambient
            development value won instead. This is not hypothetical:
            it is the exact confirmed root cause documented in
            docs/architecture/TEST-ENVIRONMENT-AND-WORKTREE-SAFETY.md,
            found when QUEUE_CONNECTION=redis and MAIL_MAILER=log
            silently shadowed this block during Phase 5 closure
            verification and produced 44 unrelated-looking test
            failures. force="true" makes this block authoritative for
            any invocation that goes through PHPUnit itself
            (`vendor/bin/phpunit`, `php artisan test`) regardless of
            ambient shell/container state. TestDatabaseGuard remains
            the fail-closed backstop for the one case force="true"
            cannot cover: a raw `php artisan` command that never
            parses this file at all (see that class's docblock and
            platform:test-db-reset).
        -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <!-- Phase 0O.5A: metrics stay in-process; a test never writes the shared Redis metrics hash. -->
        <env name="METRICS_STORE" value="array" force="true"/>
        <env name="METRICS_SCRAPE_TOKEN" value="" force="true"/>
        <env name="OBSERVABILITY_DEPLOYMENT_EVIDENCE_FILE" value="" force="true"/>
        <!--
            Real PostgreSQL, not SQLite. See ADR 0024
            (docs/architecture/adr/0024-real-postgresql-test-infrastructure.md).
            school_os_test must already be migrated via pgsql_admin
            before running this suite (CLAUDE.md has the exact command).
            The DEFAULT connection here deliberately uses the
            unprivileged school_os_app role (ADR 0021) so every test
            implicitly re-verifies RLS/role separation, not just the
            dedicated Postgres isolation suite.

            DB_HOST is deliberately the Docker Compose SERVICE alias
            (`postgres`), not `127.0.0.1`. The only realistic PHPUnit
            invocation path in this repository is inside the
            `platform` container (the host toolchain has no
            `pdo_pgsql`, see
            docs/architecture/TEST-ENVIRONMENT-AND-WORKTREE-SAFETY.md)
            so `postgres` is the value that is actually correct for
            every real invocation. Before force="true" existed on this
            block, the literal value here was `127.0.0.1` and it
            "worked" only by accident: it was always shadowed by the
            container's own already-correct ambient DB_HOST=postgres
            (set by docker-compose.yml's `environment:` block for the
            `platform` service, which is *also* ambient and would
            otherwise silently win the exact same way CACHE_STORE,
            QUEUE_CONNECTION and MAIL_MAILER did, see the block comment
            above). Two wrongs were cancelling out. force="true" makes
            this block authoritative again, so the value written here
            must now be the genuinely correct one.

            CI (127.0.0.1) and DDEV (`db`, admin role `db`) reach the
            test database elsewhere; they redirect ONLY the connection
            target, deliberately, via PHPUNIT_DB_HOST / PHPUNIT_DB_PORT /
            PHPUNIT_DB_ADMIN_USERNAME / PHPUNIT_DB_ADMIN_PASSWORD, applied
            in tests/bootstrap.php after these forced values. An ambient
            DB_HOST still never wins, and DB_DATABASE is never
            overridable.
        -->
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_HOST" value="postgres" force="true"/>
        <env name="DB_PORT" value="5432" force="true"/>
        <env name="DB_DATABASE" value="school_os_test" force="true"/>
        <env name="DB_USERNAME" value="school_os_app" force="true"/>
        <env name="DB_PASSWORD" value="school_os_app_local_only_password" force="true"/>
        <env name="DB_ADMIN_USERNAME" value="school_os" force="true"/>
        <env name="DB_ADMIN_PASSWORD" value="school_os" force="true"/>
        <!-- E21-RH.2 (ADR 0066): the dedicated retention identity; the same local-only login in every test environment. -->
        <env name="DB_RETENTION_USERNAME" value="school_os_retention" force="true"/>
        <env name="DB_RETENTION_PASSWORD" value="school_os_retention_local_only_password" force="true"/>
        <env name="DB_RETENTION_URL" value="" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="INERTIA_SSR_ENABLED" value="false" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <!-- Phase 0O.9A (ADR 0055): the deterministic fake provider and fake
             event feed, never a network; test-only keys, never real. -->
        <env name="MAIL_PROVIDER" value="fake" force="true"/>
        <env name="MAIL_SENDING_DOMAIN" value="notify.lycenza-suite.test" force="true"/>
        <env name="MAIL_FROM_NAME" value="Lycenza" force="true"/>
        <env name="MAIL_FROM_ADDRESS" value="notifications@notify.lycenza-suite.test" force="true"/>
        <env name="MAIL_SENDING_VERIFIED" value="false" force="true"/>
        <env name="MAIL_PROVIDER_EVENTS" value="fake" force="true"/>
        <env name="MAIL_PROVIDER_EVENT_SECRET" value="phpunit-only-mail-provider-event-secret-0001" force="true"/>
        <env name="MAIL_PROVIDER_EVENT_PREVIOUS_SECRET" value="" force="true"/>
        <env name="MAIL_SUPPRESSION_HMAC_KEY" value="phpunit-only-mail-suppression-hmac-key-0001" force="true"/>
        <env name="MAIL_SUPPRESSION_HMAC_KEY_ID" value="suite-1" force="true"/>
        <env name="MAIL_SUPPRESSION_HMAC_PREVIOUS_KEY" value="" force="true"/>
        <env name="MAIL_SUPPRESSION_HMAC_PREVIOUS_KEY_ID" value="" force="true"/>
        <env name="MAIL_PROVIDER_OPEN_TRACKING" value="false" force="true"/>
        <env name="MAIL_PROVIDER_CLICK_TRACKING" value="false" force="true"/>
        <env name="MAIL_PROVIDER_DEBUG" value="false" force="true"/>
        <env name="MAIL_RETENTION_DAYS" value="" force="true"/>
        <!-- Phase 0O.10A (ADR 0056): recovery is off by default; tests
             that need it enable it explicitly through config. -->
        <env name="ACCOUNT_RECOVERY_ENABLED" value="false" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
        <env name="TENANCY_ALLOW_DEV_HEADER_OVERRIDE" value="true" force="true"/>
        <!-- ADR 0053 (Phase 0O.7A): no AI Gateway and no service keys unless a
             test configures them (runtime-generated keys, never the committed
             development ones); an ambient developer .env value (including the
             retired shared token) must never leak in. -->
        <env name="AI_GATEWAY_BASE_URL" value="" force="true"/>
        <env name="AI_GATEWAY_SERVICE_SIGNING_KEY" value="" force="true"/>
        <env name="AI_GATEWAY_INBOUND_VERIFICATION_KEYS" value="" force="true"/>
        <env name="AI_GATEWAY_REPLAY_STORE" value="" force="true"/>
        <env name="AI_GATEWAY_SERVICE_TOKEN" value="" force="true"/>
        <env name="AI_GATEWAY_CONTEXT_SIGNING_KEY" value="test-only-context-signing-key" force="true"/>
        <!-- ADR 0054 (Phase 0O.8A): custom domains ON, with the fake DNS
             resolver and fake TLS prober and the development hosts (both
             honoured only because APP_ENV=testing: the double guard), a
             deterministic test-only probe key and a fake edge. Every other
             host list is forced empty so a developer .env never leaks a
             platform alias or internal host into the suite. -->
        <env name="CUSTOM_DOMAINS_ENABLED" value="true" force="true"/>
        <env name="DOMAIN_FAKES_ENABLED" value="true" force="true"/>
        <env name="DOMAIN_ALLOW_DEVELOPMENT_HOSTS" value="true" force="true"/>
        <env name="DOMAIN_PROBE_KEY" value="test-only-domain-probe-key-for-the-suite" force="true"/>
        <env name="DOMAIN_EDGE_CNAME_TARGET" value="edge.lycenza-local.invalid" force="true"/>
        <env name="DOMAIN_EDGE_ADDRESSES" value="1.2.3.4,1.2.3.5" force="true"/>
        <env name="DOMAIN_DNS_RESOLVERS" value="" force="true"/>
        <env name="DOMAIN_PLATFORM_ALIASES" value="" force="true"/>
        <env name="INTERNAL_HOSTS" value="" force="true"/>
        <env name="DOMAIN_RESERVED_HOSTS" value="" force="true"/>
        <env name="DOMAIN_RESERVED_SUFFIXES" value="" force="true"/>
        <env name="SESSION_HANDOFF_STORE" value="" force="true"/>
        <env name="CONTACT_LOOKUP_HMAC_KEY" value="test-only-contact-lookup-hmac-key" force="true"/>
        <env name="CONTACT_LOOKUP_HMAC_KEY_VERSION" value="1" force="true"/>
        <env name="STATUTORY_IDENTIFIER_LOOKUP_HMAC_KEY" value="test-only-statutory-identifier-lookup-hmac-key" force="true"/>
        <env name="STATUTORY_IDENTIFIER_LOOKUP_HMAC_KEY_VERSION" value="1" force="true"/>
    </php>
</phpunit>
