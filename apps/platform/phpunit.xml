<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            Real PostgreSQL, not SQLite. See ADR 0024
            (docs/architecture/adr/0024-real-postgresql-test-infrastructure.md).
            school_os_test must already be migrated via pgsql_admin
            before running this suite (CLAUDE.md has the exact command).
            The DEFAULT connection here deliberately uses the
            unprivileged school_os_app role (ADR 0021) so every test
            implicitly re-verifies RLS/role separation, not just the
            dedicated Postgres isolation suite.
        -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="school_os_test"/>
        <env name="DB_USERNAME" value="school_os_app"/>
        <env name="DB_PASSWORD" value="school_os_app_local_only_password"/>
        <env name="DB_ADMIN_USERNAME" value="school_os"/>
        <env name="DB_ADMIN_PASSWORD" value="school_os"/>
        <env name="DB_URL" value=""/>
        <env name="INERTIA_SSR_ENABLED" value="false"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="TENANCY_ALLOW_DEV_HEADER_OVERRIDE" value="true"/>
        <env name="AI_GATEWAY_SERVICE_TOKEN" value="dev-local-only-token"/>
        <env name="AI_GATEWAY_CONTEXT_SIGNING_KEY" value="test-only-context-signing-key"/>
    </php>
</phpunit>
