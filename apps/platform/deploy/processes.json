{
    "$comment": "Phase 0O.4A (ADR 0050 sections 1, 3, 4): the provider-neutral production process manifest. Roles, commands and the secret groups each receives -- no replica counts, no orchestrator. Guarded by Tests\\Feature\\Configuration\\ProductionProcessManifestTest.",
    "version": 1,
    "images": {
        "app": "infrastructure/docker/production/app.Dockerfile",
        "ai-gateway": "infrastructure/docker/production/ai.Dockerfile"
    },
    "secret_groups": {
        "app_runtime": ["APP_KEY", "METRICS_SCRAPE_TOKEN", "APP_PREVIOUS_KEYS", "MAIL_PASSWORD", "DB_PASSWORD", "REDIS_PASSWORD", "AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY", "AI_GATEWAY_CONTEXT_SIGNING_KEY", "AI_GATEWAY_SERVICE_SIGNING_KEY", "CONTACT_LOOKUP_HMAC_KEY", "STATUTORY_IDENTIFIER_LOOKUP_HMAC_KEY", "DOMAIN_PROBE_KEY"],
        "database_admin": ["DB_ADMIN_USERNAME", "DB_ADMIN_PASSWORD"],
        "gateway": ["SERVICE_SIGNING_KEY"]
    },
    "processes": [
        { "role": "web", "image": "app", "command": ["web"], "long_running": true, "public": true, "health": { "liveness": "/api/health/live", "readiness": "/api/health/ready" }, "metrics": { "port": 9102, "path": "/metrics", "auth": "bearer METRICS_SCRAPE_TOKEN", "exposure": "private collector network only" }, "secret_groups": ["app_runtime"] },
        { "role": "worker-default", "image": "app", "command": ["worker", "default"], "long_running": true, "queue": "default", "secret_groups": ["app_runtime"] },
        { "role": "worker-integrations", "image": "app", "command": ["worker", "integrations"], "long_running": true, "queue": "integrations", "secret_groups": ["app_runtime"] },
        { "role": "worker-notifications", "image": "app", "command": ["worker", "notifications"], "long_running": true, "queue": "notifications", "secret_groups": ["app_runtime"] },
        { "role": "scheduler", "image": "app", "command": ["scheduler"], "long_running": true, "singleton": true, "secret_groups": ["app_runtime"] },
        { "role": "ai-gateway", "image": "ai-gateway", "command": [], "long_running": true, "public": false, "health": { "liveness": "/health/live", "readiness": "/health/ready" }, "secret_groups": ["gateway"] },
        { "role": "release", "image": "app", "command": ["console", "migrate", "--database=pgsql_admin", "--force"], "long_running": false, "secret_groups": ["app_runtime", "database_admin"] },
        { "role": "operator-console", "image": "app", "command": ["console"], "long_running": false, "secret_groups": ["app_runtime", "database_admin"] }
    ]
}
