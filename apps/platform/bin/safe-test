#!/usr/bin/env bash
#
# Canonical, fail-closed test runner for apps/platform. See
# docs/architecture/TEST-ENVIRONMENT-AND-WORKTREE-SAFETY.md for the
# full incident history and design rationale.
#
# What this buys you over a bare `docker exec ... php artisan test` /
# `vendor/bin/phpunit`:
#
#   - passes explicit -e overrides for every safety-critical variable
#     on the docker exec itself, as defense-in-depth beyond
#     phpunit.xml's force="true" entries (protects the raw artisan
#     commands this script also runs, e.g. platform:test-db-reset,
#     which never parses phpunit.xml at all and so cannot benefit from
#     force="true")
#   - raises the PHP CLI memory_limit for the phpunit subprocess (the
#     default 128M reliably exhausts on this repo's full test suite;
#     `php artisan test` spawns phpunit as a real child process, so a
#     memory_limit override on the parent invocation does not reach it)
#   - runs `platform:env-diagnostic` first and refuses to proceed at
#     all if resolved configuration does not match the fail-closed
#     testing contract, instead of discovering that from 44 confusing
#     unrelated-looking test failures (see the closure-blocker
#     incident this script exists because of)
#   - never assumes which container to target: derives it from
#     whichever Docker Compose project this worktree is (or should be)
#     using, so this script gives the same answer regardless of which
#     worktree it is run from
#   - optionally runs against a dedicated, deterministically-named
#     Compose project + no published host ports, so two worktrees
#     running this script at the same time can never recreate or stop
#     each other's containers (SAFE_TEST_ISOLATED=1)
#
# Usage (run from anywhere; resolves its own paths):
#   bin/safe-test                                # full suite
#   bin/safe-test --filter=FooTest                # forwarded to phpunit
#   bin/safe-test tests/Feature/Foo/BarTest.php    # forwarded to phpunit
#   bin/safe-test --reset-db                       # reset test DB, then exit
#   bin/safe-test --diagnostic                     # print resolved config, then exit
#   SAFE_TEST_ISOLATED=1 bin/safe-test              # isolated Compose project for this worktree
#
# Everything not recognized above (--filter, a path, --testsuite, ...)
# is forwarded verbatim to `php artisan test`.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLATFORM_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
REPO_ROOT="$(cd "${PLATFORM_DIR}/../.." && pwd)"

# Test-database credentials. Must match phpunit.xml exactly -- these
# are the same inert local-dev-only values documented there and in
# CLAUDE.md, not secrets (ADR 0016).
DB_TEST_HOST="postgres"
# The Compose service's in-network port (phpunit.xml forces the same
# value). Passed explicitly because a developer's local .env may set a
# different DB_PORT for host access (e.g. to coexist with another
# PostgreSQL on 5432), and docker-compose.yml's env_file: turns it into
# an ambient container variable the raw artisan commands would honour.
DB_TEST_PORT="5432"
DB_TEST_DATABASE="school_os_test"
DB_TEST_USERNAME="school_os_app"
DB_TEST_PASSWORD="school_os_app_local_only_password"
DB_ADMIN_USERNAME="school_os"
DB_ADMIN_PASSWORD="school_os"

# The one safety-critical override set. Every value here is exactly
# what phpunit.xml's force="true" block already declares -- passing it
# again on `docker exec -e` is deliberate defense-in-depth, not
# redundancy: it also protects the raw (non-phpunit) artisan commands
# this script runs, such as platform:test-db-reset and
# platform:env-diagnostic.
SAFE_ENV=(
  -e "APP_ENV=testing"
  -e "DB_HOST=${DB_TEST_HOST}"
  -e "DB_PORT=${DB_TEST_PORT}"
  -e "DB_DATABASE=${DB_TEST_DATABASE}"
  -e "DB_USERNAME=${DB_TEST_USERNAME}"
  -e "DB_PASSWORD=${DB_TEST_PASSWORD}"
  -e "DB_ADMIN_USERNAME=${DB_ADMIN_USERNAME}"
  -e "DB_ADMIN_PASSWORD=${DB_ADMIN_PASSWORD}"
  -e "CACHE_STORE=array"
  -e "SESSION_DRIVER=array"
  -e "QUEUE_CONNECTION=sync"
  -e "MAIL_MAILER=array"
)

isolated="${SAFE_TEST_ISOLATED:-0}"
compose_files=(-f "${REPO_ROOT}/docker-compose.yml")
project_name="school-os"

if [ "${isolated}" = "1" ]; then
  # Deterministic per-worktree project name: same worktree path always
  # derives the same name (idempotent re-runs reuse the same
  # containers/volumes), and a different worktree path always derives
  # a different name (never collides). Derived from the worktree root,
  # not the current directory, so it is stable regardless of where
  # inside the worktree this script is invoked from.
  worktree_hash="$(printf '%s' "${REPO_ROOT}" | cksum | cut -d' ' -f1)"
  project_name="school-os-test-${worktree_hash}"

  override_file="$(mktemp -t "safe-test-compose-override-${worktree_hash}.XXXXXX.yml")"
  trap 'rm -f "${override_file}"' EXIT
  cat > "${override_file}" <<'EOF'
# Generated by apps/platform/bin/safe-test (SAFE_TEST_ISOLATED=1). Not
# committed -- exists only for the lifetime of this invocation.
# Strips host port publishing entirely: every real service this
# script's own docker exec calls reach postgres/redis/minio by Compose
# SERVICE NAME over this project's private network, never via a
# published host port, so no port collision with the shared "school-os"
# project or any other isolated project is possible.
services:
  postgres:
    # Compose merges list-typed keys (ports, volumes, ...) by default;
    # an empty list is a no-op, not a reset. !reset is the Compose
    # spec's explicit "actually clear the base value" tag -- verified
    # directly against `docker compose config` output before relying
    # on it here.
    ports: !reset []
  redis:
    ports: !reset []
  minio:
    ports: !reset []
  platform:
    ports: !reset []
    # Reuse the already-built shared image instead of rebuilding: same
    # Dockerfile/context, avoids depending on a working buildx install
    # for what is otherwise just "run this image against a different
    # bind mount," and avoids one isolated project silently drifting
    # from another's image if their Dockerfiles were ever built at
    # different times.
    build: !reset null
    image: school-os-platform:latest
EOF
  compose_files+=(-f "${override_file}")

  echo "[safe-test] isolated Compose project: ${project_name}" >&2
fi

compose() {
  docker compose -p "${project_name}" "${compose_files[@]}" "$@"
}

action="test"
forward_args=()
for arg in "$@"; do
  case "${arg}" in
    --reset-db) action="reset-db" ;;
    --diagnostic) action="diagnostic" ;;
    *) forward_args+=("${arg}") ;;
  esac
done

compose up -d postgres redis minio platform >&2

container_id="$(compose ps -q platform)"
if [ -z "${container_id}" ]; then
  echo "[safe-test] platform service did not start for project ${project_name}" >&2
  exit 1
fi

docker_exec() {
  docker exec "${SAFE_ENV[@]}" "${container_id}" "$@"
}

# A stale `bootstrap/cache/config.php` freezes app()->environment()
# itself, not just config() values (confirmed directly: config:cache
# taken while APP_ENV=local makes app()->environment() keep returning
# "local" even when a later invocation explicitly passes
# APP_ENV=testing). This never lets an unsafe operation through --
# TestDatabaseGuard's own environment check reads the exact same
# frozen value, so it fails CLOSED, not open -- but it produces a
# confusing "refuses to run outside APP_ENV=testing" error that has
# nothing to do with the caller's actual APP_ENV. composer.json's
# existing "test" script already clears config for this exact reason;
# this mirrors it.
docker_exec php artisan config:clear --ansi >&2

echo "[safe-test] validating resolved test configuration..." >&2
if ! docker_exec php artisan platform:env-diagnostic; then
  echo "[safe-test] refusing to proceed: resolved configuration failed the fail-closed contract (see above)." >&2
  exit 1
fi

case "${action}" in
  reset-db)
    docker_exec php artisan platform:test-db-reset --force
    ;;
  diagnostic)
    : # already printed above
    ;;
  test)
    docker_exec php -d memory_limit=1G vendor/bin/phpunit "${forward_args[@]}"
    ;;
esac
