ENVIRONMENT=local
# ADR 0053 (Phase 0O.7A): DEVELOPMENT-ONLY Ed25519 service keys, public in this
# repository and refused outside local/testing (kid prefix dev-local-only- and
# public-key fingerprint). This service's own `ai-gateway` signing key, and the
# ring of `platform` PUBLIC keys it verifies Laravel's calls against. Production
# keys come only from the managed secret store; never reuse these.
SERVICE_SIGNING_KEY='{"kty":"OKP","crv":"Ed25519","kid":"dev-local-only-ai-gateway-1","x":"WibFMaiB1A6KTbuNEVn8oOm2Qg1pUy1upMSmLbIy1tE","d":"MhiOdGyb6F13Ihhk_t67ucjsE1sR9lpjRcHBzTcrSBE","created":"2026-09-27"}'
PLATFORM_VERIFICATION_KEYS='[{"kty":"OKP","crv":"Ed25519","kid":"dev-local-only-platform-1","x":"kV3ZvDdDEsrXYdor998DAGfkdizSSsRSzKHycfGuEUQ","created":"2026-09-27"}]'
ERP_CONTRACT_BASE_URL=http://platform:8000/api/internal/ai
